APP_ENV=development
PORT=8080
DATABASE_PUBLIC_URL=postgres://taskbot:taskbot@localhost:5432/taskbot?sslmode=disable

# Create these in the Discord Developer Portal.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: register commands to one test server immediately.
DISCORD_GUILD_ID=
# Restricts commands and AI mentions to one user when set.
DISCORD_OWNER_ID=
DISCORD_LOG_CHANNEL_ID=1526851837221671043

# OpenAI API billing is separate from ChatGPT Plus.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-nano
OPENAI_BASE_URL=https://api.openai.com/v1

DEFAULT_TIMEZONE=America/New_York
SCHEDULER_INTERVAL=15s
SCHEDULER_CLAIM_LIMIT=25

# Local first-party dashboard login. A hash is safer, but plaintext is supported.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-long-unique-password
# Optional safer alternative; generate with: go run ./cmd/hash-password
DASHBOARD_PASSWORD_HASH=
DASHBOARD_BASE_URL=https://discord-task-bot-production.up.railway.app
